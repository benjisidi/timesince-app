[Unit]
Description=Back up the TimeSince production database
Wants=network-online.target
After=local-fs.target network-online.target
ConditionPathExists=!/var/lib/timesince/deployment-in-progress

[Service]
Type=oneshot
User=timesince
Group=timesince
WorkingDirectory=/opt/timesince/current
EnvironmentFile=/etc/timesince/timesince.env
ExecStart=/usr/bin/env node dist/server/backup.js --label daily
ExecStartPost=/usr/bin/env node dist/server/sync-backups.js
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/backups/timesince /var/lib/timesince
RestrictSUIDSGID=true
