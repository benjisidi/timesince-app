# Application configuration. This file is installed as
# /etc/timesince/timesince.env with mode 0640 and root:timesince ownership.
NODE_ENV=production
TIME_ZONE=Europe/London
DATABASE_PATH=/var/lib/timesince/timesince.sqlite
PORT=3000

# SQLite-consistent backups and local retention.
BACKUP_DIRECTORY=/var/backups/timesince
BACKUP_RETENTION_COUNT=30

# Required rclone destination. The configured remote must be accessible to the
# timesince service user. `rclone copy` is used so remote deletion is never
# propagated from local retention.
RCLONE_REMOTE=gdrive
RCLONE_BACKUP_PATH=TimeSince/backups
RCLONE_CONFIG=/var/lib/timesince/rclone/rclone.conf
# RCLONE_BINARY=/usr/bin/rclone

# If Node is installed outside systemd's default search path, set PATH so
# /usr/bin/env can locate it. The host deployment script also accepts explicit
# TIMESINCE_NODE_BINARY and TIMESINCE_NPM_BINARY paths from the development host.
# PATH=/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
